{
  "name": "@js-toolkit/eslint-config",
  "version": "1.3.0",
  "description": "Shared ESLint flat config with custom rules (common + web)",
  "author": "VZH",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/js-toolkit/configs",
    "directory": "eslint-config"
  },
  "exports": {
    "./plugin": {
      "types": "./dist/rules/plugin.d.ts",
      "import": "./dist/rules/plugin.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist/*",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "release": "release-it"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript": ">=5.0.0",
    "typescript-eslint": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-config-airbnb-base": {
      "optional": true
    },
    "eslint-config-airbnb": {
      "optional": true
    },
    "eslint-plugin-import": {
      "optional": true
    },
    "eslint-plugin-import-x": {
      "optional": true
    },
    "eslint-import-resolver-typescript": {
      "optional": true
    },
    "eslint-plugin-promise": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-react-compiler": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-prettier": {
      "optional": true
    },
    "eslint-config-prettier": {
      "optional": true
    },
    "eslint-plugin-jsdoc": {
      "optional": true
    },
    "eslint-plugin-tsdoc": {
      "optional": true
    },
    "eslint-plugin-wc": {
      "optional": true
    },
    "eslint-plugin-lit": {
      "optional": true
    },
    "eslint-plugin-mobx": {
      "optional": true
    },
    "@babel/eslint-parser": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/compat": "2.0.4",
    "@eslint/js": "10.0.1",
    "globals": "17.4.0",
    "ts-api-utils": "2.5.0",
    "@js-toolkit/config-utils": "workspace:^"
  },
  "devDependencies": {
    "@typescript-eslint/utils": "8.70.0",
    "@js-toolkit/tsconfig": "workspace:*",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "prettier": "3.9.6",
    "release-it": "21.0.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
